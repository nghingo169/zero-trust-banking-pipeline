// Banking Silver Layer - V2 Entity-based Atomic Warehouse
//
// Bronze contract:
//   /Users/skadi2910/projects/mock-data-generator/docs/v2/Banking_Mock_Data_Schema.dbml
//
// Silver responsibilities:
//   - Match Core, CRM, KYC, servicing, and AML customer references to Party.
//   - Standardise source codes, dates, timestamps, identifiers, and formats.
//   - Deduplicate at each source entity's declared business grain.
//   - Resolve source references into stable Silver foreign keys where evidence
//     is sufficient, while retaining unresolved raw references.
//   - Preserve source-provided lifecycle events, snapshots, and effective dates.
//
// Deliberate boundaries imposed by the V2 Bronze contract:
//   - There is no Payment Order. payment_gateway_log is a Gateway Attempt.
//   - There is no Cardholder master. A Card is linked to its Account, not to a
//     claimed individual Cardholder.
//   - customer_kyc supports a simple KYC record, not document and verification
//     attempt submodels.
//   - Account Posting, Card Transaction, Gateway Attempt, and ATM Interaction
//     are separate observable business activities.
//   - Typed status events remain dependent child entities. There is no generic
//     Transaction Object or universal Event table.
//   - Complex reporting, KPIs, inferred behaviour, and departmental rules
//     belong in Gold.

Project banking_silver_atomic_warehouse_v2 {
  database_type: 'PostgreSQL'
  Note: '''
  Cleansed, conformed, source-traceable Silver model derived from the V2 mock
  banking Bronze contract.

  The model provides an enterprise view of supported entities without inventing
  unsupported Payment, Cardholder, currency, or identity relationships. Raw
  Bronze history remains the replayable system of ingestion; Silver retains
  current conformed entities plus atomic events, snapshots, and relationships.

  PII, PCI, KYC, counterparty, and investigation fields require encryption,
  tokenisation, masking, and restricted access in the physical implementation.
  '''
}

TableGroup technical_support {
  source_system
  load_batch
  canonical_code
  source_code_mapping
  reference_resolution_issue
  data_quality_issue
}

TableGroup party_and_servicing {
  party
  party_source_key
  party_kyc_record
  employment_profile
  service_request
  customer_interaction
}

TableGroup accounts {
  account
  account_party_role
  account_balance_snapshot
  transaction_channel
  account_posting
  account_posting_status_event
}

TableGroup cards {
  payment_card
  card_limit_period
  card_transaction
  card_transaction_status_event
  card_fraud_indicator
  chargeback
}

TableGroup processing_and_merchants {
  merchant
  merchant_location
  gateway_attempt
  gateway_attempt_status_event
  atm_interaction
  atm_interaction_status_event
}

TableGroup financial_crime {
  risk_assessment
  alert
  alert_evidence
  watchlist_entry
  sanction_screening
  investigation_case
  aml_case_detail
  case_evidence
  investigation_note
  regulatory_report
}

// ============================================================================
// TECHNICAL LINEAGE, CODE CONFORMANCE, AND DATA QUALITY
// ============================================================================

Table source_system {
  source_system_id bigint [pk, increment]
  source_system_code varchar [not null, unique, note: 'CORE_BANKING / CRM / KYC / CARD_SYSTEM / PAYMENT_GATEWAY / ATM / FIN_CRIME / CALL_CENTRE']
  source_system_name varchar [not null]
  active_from timestamp [not null]
  active_to timestamp
}

Table load_batch {
  load_batch_id bigint [pk, increment]
  source_system_id bigint [not null]
  batch_reference varchar [not null]
  source_extract_date date
  source_file_name varchar
  schema_version varchar
  ingestion_started_at timestamp [not null]
  ingestion_completed_at timestamp
  batch_status_code varchar [not null]

  indexes {
    (source_system_id, batch_reference) [unique]
  }
}

Table canonical_code {
  canonical_code_id bigint [pk, increment]
  code_domain varchar [not null, note: 'ACCOUNT_STATUS / POSTING_STATUS / CARD_STATUS / ALERT_STATUS / CASE_STATUS / etc.']
  canonical_code varchar [not null]
  canonical_description varchar
  active_from timestamp [not null]
  active_to timestamp

  indexes {
    (code_domain, canonical_code) [unique]
  }
}

Table source_code_mapping {
  source_code_mapping_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_field_name varchar [not null]
  source_code varchar [not null]
  canonical_code_id bigint [not null]
  effective_from timestamp [not null]
  effective_to timestamp
  mapping_rule_version varchar [not null]

  indexes {
    (source_system_id, source_field_name, source_code, effective_from) [unique]
  }
}

Table reference_resolution_issue {
  reference_resolution_issue_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_object_type_code varchar [not null]
  source_object_id varchar [not null]
  reference_field_name varchar [not null]
  target_entity_type_code varchar [not null]
  raw_reference_value varchar
  resolution_status_code varchar [not null, note: 'NOT_YET_AVAILABLE / NOT_FOUND / AMBIGUOUS / INVALID_REFERENCE']
  candidate_count integer
  first_seen_at timestamp [not null]
  last_seen_at timestamp [not null]
  resolved_at timestamp
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_object_type_code, source_object_id, reference_field_name) [unique]
  }
}

Table data_quality_issue {
  data_quality_issue_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_object_type_code varchar [not null]
  source_object_id varchar [not null]
  rule_code varchar [not null]
  severity_code varchar [not null, note: 'INFO / WARNING / ERROR / QUARANTINE']
  field_name varchar
  observed_value varchar
  issue_status_code varchar [not null, note: 'OPEN / ACCEPTED / RESOLVED']
  detected_at timestamp [not null]
  resolved_at timestamp
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_object_type_code, source_object_id, rule_code, field_name) [unique]
  }
}

// ============================================================================
// PARTY, KYC, AND CUSTOMER SERVICING
// ============================================================================

Table party {
  party_id bigint [pk, increment]
  party_type_code varchar [not null, note: 'PERSON / ORGANISATION']
  full_name varchar
  date_of_birth date
  national_id varchar [note: 'Restricted; not a unique enterprise identifier']
  phone_number varchar
  email_address varchar
  address_text text
  preferred_contact_method_code varchar
  survivorship_rule_version varchar [not null]
  first_recorded_at timestamp [not null]
  last_conformed_at timestamp [not null]
  load_batch_id bigint [not null]

  Note: 'Current conformed Party assembled from confirmed source identities. Ambiguous source identities are not forcibly merged.'
}

Table party_source_key {
  party_source_key_id bigint [pk, increment]
  party_id bigint [not null]
  source_system_id bigint [not null]
  source_object_type_code varchar [not null, note: 'CORE_CUSTOMER / CRM_PARTY / KYC_RECORD / AML_CUSTOMER_REFERENCE']
  source_party_id varchar [not null]
  source_cif_number varchar
  match_method_code varchar [not null, note: 'EXPLICIT_REFERENCE / CIF / NATIONAL_ID / COMPOSITE / PROBABILISTIC / STEWARD']
  match_confidence decimal(8,6)
  match_status_code varchar [not null, note: 'CONFIRMED / CANDIDATE / REJECTED / SPLIT']
  effective_from timestamp [not null]
  effective_to timestamp
  is_current boolean [not null]
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_object_type_code, source_party_id, effective_from) [unique]
    (party_id, source_system_id, is_current)
  }
}

Table party_kyc_record {
  party_kyc_record_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_kyc_id varchar [not null]
  party_id bigint
  source_customer_reference varchar
  identity_type_code varchar
  identity_number varchar [note: 'Restricted; passport matching is unsafe without issuing country']
  verification_status_code varchar
  verified_date date
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_kyc_id) [unique]
  }

  Note: 'Simple source-supported KYC record. V2 does not provide document issuer, expiry, or verification-attempt history.'
}

Table employment_profile {
  employment_profile_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_employment_id varchar [not null]
  party_id bigint
  source_customer_reference varchar
  employer_name varchar
  job_title varchar
  monthly_income decimal(18,2)
  income_currency_code varchar [note: 'Nullable because V2 Bronze does not provide income currency']
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_employment_id) [unique]
  }
}

Table service_request {
  service_request_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_request_id varchar [not null]
  party_id bigint
  source_customer_reference varchar
  request_type_code varchar
  channel_code varchar
  request_date date
  request_status_code varchar
  resolution_date date
  description text
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_request_id) [unique]
  }
}

Table customer_interaction {
  customer_interaction_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_interaction_id varchar [not null]
  party_id bigint
  investigation_case_id bigint
  source_customer_reference varchar
  caller_phone varchar
  interaction_type_code varchar [not null, note: 'CALL']
  interaction_reason_code varchar
  agent_id varchar
  duration_seconds bigint
  occurred_at timestamp
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_interaction_id) [unique]
  }
}

// ============================================================================
// ACCOUNTS AND ACCOUNT POSTINGS
// ============================================================================

Table account {
  account_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_account_id varchar [not null]
  source_primary_customer_reference varchar
  source_primary_cif_number varchar
  product_type_code varchar
  account_status_code varchar
  open_date date
  branch_code varchar
  servicing_model_code varchar
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_account_id) [unique]
  }

  Note: 'V2 does not provide account number, currency, close date, or source update timestamp.'
}

Table account_party_role {
  account_party_role_id bigint [pk, increment]
  account_id bigint [not null]
  party_id bigint
  source_account_holder_link_id varchar [not null]
  source_cif_number varchar [not null]
  relationship_type_code varchar
  linked_date date
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_account_holder_link_id) [unique]
    (account_id, source_cif_number) [unique]
  }

  Note: 'Complete account-holder relationship from customer_account. A nullable Party FK permits late or ambiguous identity resolution.'
}

Table account_balance_snapshot {
  account_balance_snapshot_id bigint [pk, increment]
  account_id bigint
  source_balance_id varchar [not null]
  balance_date date
  opening_balance decimal(18,2)
  closing_balance decimal(18,2)
  available_balance decimal(18,2)
  currency_code varchar [note: 'Nullable because V2 Account and Balance sources do not provide currency']
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_balance_id) [unique]
    (account_id, balance_date) [unique]
  }
}

Table transaction_channel {
  transaction_channel_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_channel_id varchar [not null]
  channel_name varchar
  channel_type_code varchar
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_channel_id) [unique]
  }
}

Table account_posting {
  account_posting_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_account_transaction_id varchar [not null]
  account_id bigint
  party_id bigint
  transaction_channel_id bigint
  merchant_id bigint
  source_customer_reference varchar
  posting_type_code varchar [note: 'DEPOSIT / WITHDRAWAL / TRANSFER / FEE / INTEREST / REVERSAL / ACCOUNT_PAYMENT']
  direction_code varchar [note: 'DEBIT / CREDIT']
  amount decimal(18,2)
  currency_code varchar [note: 'Nullable because V2 Bronze does not provide posting currency']
  occurred_at timestamp
  current_status_code varchar
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_account_transaction_id) [unique]
  }

  Note: 'Atomic posting against one account. It is not a Payment Order or a double-entry journal header.'
}

Table account_posting_status_event {
  account_posting_status_event_id bigint [pk, increment]
  account_posting_id bigint [not null]
  source_status_event_id varchar [not null]
  status_code varchar [not null]
  status_timestamp timestamp [not null]
  source_arrival_timestamp timestamp [not null]
  sequence_number bigint [not null]
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_status_event_id) [unique]
    (account_posting_id, sequence_number) [unique]
  }
}

// ============================================================================
// CARDS
// ============================================================================

Table payment_card {
  payment_card_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_card_id varchar [not null]
  funding_account_id bigint
  source_funding_account_id varchar
  pan_token varchar [not null, note: 'Tokenised from the restricted source card number']
  masked_pan varchar
  card_type_code varchar
  issue_date date
  expiry_date date
  card_status_code varchar
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_card_id) [unique]
    (pan_token) [unique]
  }

  Note: 'Issued card linked to its funding Account. V2 cannot identify a specific Cardholder Party.'
}

Table card_limit_period {
  card_limit_period_id bigint [pk, increment]
  payment_card_id bigint
  source_card_limit_history_id varchar [not null]
  limit_amount decimal(18,2)
  currency_code varchar [note: 'Nullable because V2 Bronze does not provide limit currency']
  effective_from date
  effective_to date [note: 'Derived from the next effective record when available']
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_card_limit_history_id) [unique]
    (payment_card_id, effective_from) [unique]
  }
}

Table card_transaction {
  card_transaction_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_card_transaction_id varchar [not null]
  payment_card_id bigint
  merchant_id bigint
  transaction_type_code varchar [note: 'PURCHASE / REFUND / REVERSAL / FEE']
  amount decimal(18,2)
  currency_code varchar [note: 'Nullable because V2 Bronze does not provide card-transaction currency']
  occurred_at timestamp
  current_status_code varchar
  source_is_fraud boolean
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_card_transaction_id) [unique]
  }

  Note: 'Card-network activity. ATM withdrawals are represented by ATM Interaction plus Account Posting.'
}

Table card_transaction_status_event {
  card_transaction_status_event_id bigint [pk, increment]
  card_transaction_id bigint [not null]
  source_status_event_id varchar [not null]
  status_code varchar [not null]
  status_timestamp timestamp [not null]
  source_arrival_timestamp timestamp [not null]
  sequence_number bigint [not null]
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_status_event_id) [unique]
    (card_transaction_id, sequence_number) [unique]
  }
}

Table card_fraud_indicator {
  card_fraud_indicator_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_flag_id varchar [not null]
  card_transaction_id bigint
  flag_reason varchar
  flag_date date
  resolution_status_code varchar
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_flag_id) [unique]
  }

  Note: 'Detection indicator associated with a Card Transaction. It is not conformed into Alert without proof of a shared alert workflow.'
}

Table chargeback {
  chargeback_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_chargeback_id varchar [not null]
  card_transaction_id bigint
  reason_code varchar
  dispute_amount decimal(18,2)
  currency_code varchar [note: 'Nullable because V2 Bronze does not provide chargeback currency']
  filed_date date
  chargeback_status_code varchar
  resolved_date date
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_chargeback_id) [unique]
  }
}

// ============================================================================
// GATEWAY, ATM, AND MERCHANT PROCESSING
// ============================================================================

Table merchant {
  merchant_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_merchant_id varchar [not null]
  merchant_name varchar
  merchant_category_code varchar
  country_code varchar
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_merchant_id) [unique]
  }
}

Table merchant_location {
  merchant_location_id bigint [pk, increment]
  merchant_id bigint
  source_merchant_store_id varchar [not null]
  location_name varchar
  location_description varchar
  location_type_code varchar
  address_text varchar
  risk_rating_code varchar
  registered_date date
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_merchant_store_id) [unique]
  }
}

Table gateway_attempt {
  gateway_attempt_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_gateway_transaction_id varchar [not null]
  provider_payment_reference varchar
  payment_method_code varchar
  account_posting_id bigint
  card_transaction_id bigint
  merchant_id bigint
  amount decimal(18,2)
  currency_code varchar
  current_status_code varchar
  attempted_at timestamp
  provider_code varchar
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_gateway_transaction_id) [unique]
  }

  Note: 'Provider-processing attempt. V2 supplies no independent Payment Instruction, payer, payee, rail, or end-to-end payment identity.'
}

Table gateway_attempt_status_event {
  gateway_attempt_status_event_id bigint [pk, increment]
  gateway_attempt_id bigint [not null]
  source_status_event_id varchar [not null]
  source_account_transaction_id varchar
  source_card_transaction_id varchar
  status_code varchar [not null]
  status_timestamp timestamp [not null]
  source_arrival_timestamp timestamp [not null]
  sequence_number bigint [not null]
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_status_event_id) [unique]
    (gateway_attempt_id, sequence_number) [unique]
  }
}

Table atm_interaction {
  atm_interaction_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_atm_log_id varchar [not null]
  payment_card_id bigint
  account_posting_id bigint
  source_card_id varchar
  source_card_pan_token varchar
  card_match_method_code varchar [note: 'CARD_ID / PAN_TOKEN / UNRESOLVED']
  atm_id varchar
  interaction_type_code varchar [note: 'WITHDRAWAL / BALANCE_INQUIRY / PIN_CHANGE / DEPOSIT']
  amount decimal(18,2)
  currency_code varchar [note: 'Nullable because V2 Bronze does not provide ATM currency']
  occurred_at timestamp
  response_code varchar
  current_status_code varchar
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_atm_log_id) [unique]
  }

  Note: 'ATM switch activity. Non-financial actions legitimately have no Account Posting.'
}

Table atm_interaction_status_event {
  atm_interaction_status_event_id bigint [pk, increment]
  atm_interaction_id bigint [not null]
  source_status_event_id varchar [not null]
  source_account_transaction_id varchar
  status_code varchar [not null]
  status_timestamp timestamp [not null]
  source_arrival_timestamp timestamp [not null]
  sequence_number bigint [not null]
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_status_event_id) [unique]
    (atm_interaction_id, sequence_number) [unique]
  }
}

// ============================================================================
// FINANCIAL CRIME AND INVESTIGATIONS
// ============================================================================

Table risk_assessment {
  risk_assessment_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_risk_score_id varchar [not null]
  account_posting_id bigint
  model_score decimal(8,6)
  risk_band_code varchar
  assessed_date date
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_risk_score_id) [unique]
  }

  Note: 'Source scoring result for one Account Posting. V2 does not provide model name, version, features, or decision.'
}

Table alert {
  alert_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_alert_entity_type_code varchar [not null, note: 'FRAUD_ALERT / TRANSACTION_MONITORING_ALERT']
  source_alert_id varchar [not null]
  party_id bigint
  source_customer_reference varchar
  alert_domain_code varchar [not null, note: 'FRAUD / TRANSACTION_MONITORING']
  alert_type_code varchar
  alert_score decimal(8,4)
  alert_status_code varchar
  generated_at timestamp
  source_time_precision_code varchar [not null, note: 'DATE / TIMESTAMP']
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_alert_entity_type_code, source_alert_id) [unique]
  }

  Note: 'Enterprise Alert conformed from fraud_alert and transaction_monitoring_alert. Date-only source times retain an explicit precision indicator.'
}

Table alert_evidence {
  alert_evidence_id bigint [pk, increment]
  alert_id bigint [not null]
  source_evidence_link_type_code varchar [not null, note: 'DIRECT_FRAUD_ALERT / MONITORING_ACCOUNT_LINK / MONITORING_CARD_LINK']
  source_evidence_link_id varchar [not null]
  account_posting_id bigint
  card_transaction_id bigint
  is_primary boolean
  evidence_role_code varchar [note: 'PRIMARY / SUPPORTING']
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_evidence_link_type_code, source_evidence_link_id) [unique]
  }

  Note: 'Exactly one evidence FK is populated. Direct fraud-alert links generate a deterministic Silver evidence-link identifier.'
}

Table watchlist_entry {
  watchlist_entry_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_watchlist_id varchar [not null]
  entity_name varchar
  list_type_code varchar
  country_code varchar
  added_date date
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_watchlist_id) [unique]
  }
}

Table sanction_screening {
  sanction_screening_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_screening_id varchar [not null]
  party_id bigint
  watchlist_entry_id bigint
  source_customer_reference varchar
  screened_name varchar
  match_score decimal(8,6)
  screening_date date
  screening_result_code varchar
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_screening_id) [unique]
  }
}

Table investigation_case {
  investigation_case_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_case_id varchar [not null]
  party_id bigint
  party_link_method_code varchar [note: 'AML_CASE / ALERT / EVIDENCE / STEWARD']
  investigation_type_code varchar [note: 'FRAUD / AML']
  case_origin_code varchar
  case_status_code varchar
  priority_code varchar
  opened_at timestamp
  closed_at timestamp
  assigned_analyst_id varchar
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_case_id) [unique]
  }
}

Table aml_case_detail {
  aml_case_detail_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_aml_case_id varchar [not null]
  investigation_case_id bigint
  party_id bigint
  source_customer_reference varchar
  case_type_code varchar
  risk_level_code varchar
  opened_date date
  closed_date date
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_aml_case_id) [unique]
    (investigation_case_id) [unique]
  }

  Note: 'Compliance-system extension of the enterprise Investigation Case, not a second independent case root.'
}

Table case_evidence {
  case_evidence_id bigint [pk, increment]
  investigation_case_id bigint [not null]
  source_evidence_link_type_code varchar [not null, note: 'MONITORING_ALERT / FRAUD_ALERT / CARD_FRAUD_INDICATOR / SANCTION_SCREENING / ACCOUNT_POSTING / CARD_TRANSACTION']
  source_evidence_link_id varchar [not null]
  alert_id bigint
  card_fraud_indicator_id bigint
  sanction_screening_id bigint
  account_posting_id bigint
  card_transaction_id bigint
  evidence_role_code varchar [note: 'PRIMARY / RELATED / CUSTOMER_DISPUTE / SUPPORTING']
  linked_at timestamp
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_evidence_link_type_code, source_evidence_link_id) [unique]
  }

  Note: 'Exactly one evidence FK is populated. Six typed V2 case-link tables are conformed into this controlled relationship.'
}

Table investigation_note {
  investigation_note_id bigint [pk, increment]
  investigation_case_id bigint
  source_investigation_note_id varchar [not null]
  author_id varchar
  note_timestamp timestamp
  source_arrival_timestamp timestamp
  note_type_code varchar
  note_text text
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_investigation_note_id) [unique]
  }
}

Table regulatory_report {
  regulatory_report_id bigint [pk, increment]
  source_system_id bigint [not null]
  source_regulatory_report_id varchar [not null]
  aml_case_detail_id bigint
  report_type_code varchar [not null, note: 'SAR']
  filed_date date
  regulatory_reference varchar
  report_status_code varchar
  recorded_at timestamp [not null]
  load_batch_id bigint [not null]

  indexes {
    (source_system_id, source_regulatory_report_id) [unique]
  }
}

